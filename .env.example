# Set a server-side key to enable AI character distillation and dialogue.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
PORT=8788
# HOST=127.0.0.1  # Local desktop only. Use scripts/start-local-server.ps1 for phone access.

# QQ 邮箱设置 → 账户 → POP3/SMTP 服务，使用授权码而非邮箱登录密码。
QQ_SMTP_USER=
QQ_SMTP_AUTH_CODE=
# 公开部署时设为 true，让 AI 接口只接受已登录用户。
AUTH_REQUIRED=false
# 公开部署时设为持久磁盘路径，确保重启后账号和数据仍在。
# ACCOUNT_DB_PATH=./server/data/accounts.json

# Set this only when building a native app. A trusted LAN IP may use HTTP during local testing.
# VITE_API_BASE_URL=https://your-api-domain.example
# ALLOWED_ORIGINS=capacitor://localhost,http://localhost:5173
